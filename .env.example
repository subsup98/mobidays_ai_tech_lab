LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
LLM_FALLBACK=mock

INPUT_MODE=audio
DB_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobidays_app
# DATABASE_PATH=data/app_quality.db  # SQLite 사용 시에만 설정
VECTOR_DB_PATH=data/vector/faiss_action_items

# Optional: required only if pyannote-based diarization is enabled.
HUGGINGFACE_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_NUM_SPEAKERS=
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
STT_MODEL=large-v3
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
